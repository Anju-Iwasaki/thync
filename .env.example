NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # ブラウザに出てよい鍵
SUPABASE_SERVICE_ROLE_KEY=            # サーバー専用。岩崎のみ。NEXT_PUBLIC_ を付けない

#LLM
GEMINI_API_KEY=                       # 岩崎・楠奥のみ
