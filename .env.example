GEMINI_EMBEDDING_MODEL=

#開発用
USE_MOCK_LLM=true                     # キーがなくても動かせる
NEXT_PUBLIC_DEFAULT_ANALYSIS_MODE=reaction   # reaction | all
NEXT_PUBLIC_SHOW_MODE_SWITCH=false    # 部屋作成画面に方式の選択を出すか

#サーバー処理の起動（Webhooksを使う場合のみ）
ANALYZE_WEBHOOK_SECRET=